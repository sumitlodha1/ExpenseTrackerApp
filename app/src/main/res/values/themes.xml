<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ExpenseTracker" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#006d77</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        
        <item name="colorPrimaryContainer">#83c5be</item>
        <item name="colorOnPrimaryContainer">#002022</item>
        
        <item name="colorSecondary">#e29578</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#f9d7cc</item>
        <item name="colorOnSecondaryContainer">#3a0b00</item>
        
        <item name="colorSurface">#ffddd2</item>
        <item name="colorOnSurface">#201A18</item>
        <item name="colorSurfaceVariant">#f5cec2</item>
        
        <item name="android:windowBackground">#edf6f9</item>
        
        <item name="colorOutline">#006d77</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
    </style>

    <style name="Theme.ExpenseTracker" parent="Base.Theme.ExpenseTracker" />

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="TextAppearance.App.Toolbar" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:textColor">#006d77</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">#006d77</item>
    </style>

    <style name="Widget.App.TextInputLayout.Dense" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">#006d77</item>
    </style>

    <style name="ShapeAppearance.App.CircleFAB" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>